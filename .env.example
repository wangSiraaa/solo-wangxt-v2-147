# HTTP listen address
HTTP_ADDR=:8080

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Policy persistence: memory (ephemeral, dev default) or postgres.
# Setting POSTGRES_DSN implies postgres.
POLICY_BACKEND=memory
POSTGRES_DSN=
# postgres://ratelimit:ratelimit@127.0.0.1:5432/ratelimit?sslmode=disable

# Cache refresh fallback (Postgres NOTIFY is the primary invalidation path)
POLICY_REFRESH=30s

# Redis call budget per decision before the fail policy applies
DECISION_BUDGET=200ms

# Decision RETRY idempotency window (bounded, separate from business dedup)
IDEM_ALLOW_TTL=60s
IDEM_DENY_TTL=5s

# Business request dedup window (default; per-request TTL up to 7 days)
DEDUP_TTL=24h

# Bucket key idle floor (keys expire after full-refill time + floor)
IDLE_TTL_FLOOR=5m

# Seed demo policies/endpoints (memory always; postgres only if empty)
SEED_DEMO=true
